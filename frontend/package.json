{
  "name": "zenalitics-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/gen-fixture.ts --if-missing",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:api": "node scripts/gen-api.ts",
    "fixture": "node scripts/gen-fixture.ts",
    "smoke": "node scripts/smoke-backend.ts"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "5.3.0",
    "@fontsource-variable/onest": "5.3.1",
    "@mantine/core": "9.7.2",
    "@mantine/dates": "9.7.2",
    "@mantine/hooks": "9.7.2",
    "@mantine/notifications": "9.7.2",
    "@tabler/icons-react": "3.49.0",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-router": "1.170.42",
    "dayjs": "1.11.23",
    "echarts": "6.1.0",
    "openapi-fetch": "0.17.0",
    "papaparse": "5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.2",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
